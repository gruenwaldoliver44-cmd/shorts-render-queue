 "title": "FT4 Standbilder",
 "retries": 0,
 "min_free_gb": 4,
 "timeout_min": 90,
 "expires": "2026-11-02T22:00:00Z",
 "steps": [
  {
   "label": "Pack",
   "run": "rm -rf ct tex && cp -R \"$HOME/ShortsRenderAgent/repo/packs/ft4/ct\" \"$HOME/ShortsRenderAgent/repo/packs/ft4/tex\" . && ls ct"
  },
  {
   "label": "Szene bauen",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b -P ct/scene.py > build.log 2>&1; grep -v -i -E 'bearer|api_key|deprecat|use_nodes' build.log | tail -30; grep -q 'SCENE OK' build.log"
  },
  {
   "label": "Standbilder",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/stills.py -- $PWD/o 0.5,3.0,6.5,10.0,15.0,17.5,20.0,23.0,25.5,27.5,30.0 > stills.log 2>&1; tail -40 stills.log | grep -v -i blendkit; ls o/*.jpg >/dev/null 2>&1 || { echo RETRY_CPU; CPU_ONLY=1 CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/stills.py -- $PWD/o 0.5,3.0,6.5,10.0,15.0,17.5,20.0,23.0,25.5,27.5,30.0 > stills_cpu.log 2>&1; tail -30 stills_cpu.log | grep -v -i blendkit; }; cd o && zip -q -j ../ft4_s3.zip *.jpg; cd ..; ls -la ft4_s3.zip; true"
  }
 ],

 "steps": [
  {
   "label": "Pack",
   "run": "rm -rf ct tex && cp -R \"$HOME/ShortsRenderAgent/repo/packs/mt4/ct\" \"$HOME/ShortsRenderAgent/repo/packs/mt4/tex\" . && ls ct"
  },
  {
   "label": "Szene bauen",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b -P ct/scene.py > build.log 2>&1; grep -v -i -E 'bearer|api_key|deprecat|use_nodes' build.log | tail -30; grep -q 'SCENE OK' build.log"
  },
  {
   "label": "Standbilder",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/stills.py -- $PWD/o 0.5,3.5,6.5,9.0,13.0,17.0,21.5,23.7,25.0,28.5 > stills.log 2>&1; tail -3 stills.log; cd o && zip -q -j ../mt4_s2.zip *.jpg; cd ..; ls -la mt4_s2.zip; true"
  }

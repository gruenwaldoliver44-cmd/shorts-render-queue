{
 "id": "0002-blender-check",
 "type": "shell",
 "steps": [
  "{ echo '== apps'; ls -d /Applications/Blender*.app ~/Applications/Blender*.app 2>/dev/null; for a in /Applications/Blender*.app; do defaults read \"$a/Contents/Info\" CFBundleShortVersionString; done; echo '== downloads'; ls -lt ~/Downloads | head -15; echo '== blender config'; ls ~/Library/Application\\ Support/Blender 2>/dev/null; find ~/Library/Application\\ Support/Blender -maxdepth 5 -iname '*blenderkit*' 2>/dev/null | head; echo '== blenderkit data'; ls ~/blenderkit_data 2>/dev/null | head; df -h ~ | tail -1; } > result.txt 2>&1"
 ],

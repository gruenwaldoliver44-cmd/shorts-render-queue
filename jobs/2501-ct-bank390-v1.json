   "run": "curl -fsSL -o ctpack.zip 'https://d2ol7oe51mr4n9.cloudfront.net/user_38Z8oWSnRHNn2APJObaAQyRFvxH/4d4eb1bf-ef50-4fb8-99db-f2d675d7523c.zip' && rm -rf ct tex assets && unzip -oq ctpack.zip && ls ct"
  },
  {
   "label": "Patch",
   "run": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup --python-expr \"p='ct/scene.py'; s=open(p).read(); s=s.replace(\\\"; sc.view_settings.look = 'AgX - Medium High Contrast'\\\", '\\ntry: sc.view_settings.look = \\\"AgX - Medium High Contrast\\\"\\nexcept Exception as e: print(\\\"look skip\\\", e)'); open(p,'w').write(s); compile(s,p,'exec'); print('PATCHED')\" 2>&1 | grep PATCHED"
  },
  {
   "label": "Baue 3D-Szene",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b -P ct/scene.py > build.log 2>&1; tail -5 build.log; grep -q 'SCENE OK' build.log"
  },
  {
   "label": "Rendere 999 Frames (Metal GPU)",
   "run": "rm -f out_*.mp4 out.mp4; CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/render.py -- mac $PWD/out_ 32 1 999 > render.log 2>&1; grep -E 'DEVICES|MAC RENDER DONE|Error' render.log | head -5; f=$(ls out_*.mp4 | head -1); test -n \"$f\" && mv \"$f\" out.mp4 && ls -la out.mp4",
   "progress": {
    "log": "render.log",
    "total": 999
   }
  }

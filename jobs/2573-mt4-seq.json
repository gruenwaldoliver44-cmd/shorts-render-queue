{
 "id": "2573-mt4-seq",
 "type": "shell",
 "title": "MT4 Rauchmelder Vollrender",
 "retries": 0,
 "min_free_gb": 6,
 "timeout_min": 600,
 "expires": "2026-11-03T22:00:00Z",
 "steps": [
  {
   "label": "Pack",
   "run": "mkdir -p frames && rm -rf ct tex && cp -R \"$HOME/ShortsRenderAgent/repo/packs/mt4/ct\" \"$HOME/ShortsRenderAgent/repo/packs/mt4/tex\" . && ls ct"
  },
  {
   "label": "Szene bauen",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b -P ct/scene.py > build.log 2>&1; grep -v -i -E 'bearer|api_key|deprecat|use_nodes' build.log | tail -20; grep -q 'SCENE OK' build.log && cp ct/proj.json proj.txt"
  },
  {
   "label": "Vollrender 1080x1920",
   "progress": {
    "dir": "frames",
    "total": 740
   },
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/render.py -- seq $PWD/frames 12 > render.log 2>&1; tail -3 render.log; ls frames | wc -l"
  },
  {
   "label": "Packen",
   "run": "cd frames && zip -q -0 ../mt4_frames.zip f*.jpg; cd ..; ls -la mt4_frames.zip"
  }
 ],

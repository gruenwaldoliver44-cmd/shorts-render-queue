 "steps": [
  {
   "label": "Szene aus Repo",
   "run": "rm -rf ct tex && cp -R \"$HOME/ShortsRenderAgent/repo/packs/mt2/ct\" \"$HOME/ShortsRenderAgent/repo/packs/mt2/tex\" . && ls ct tex | head -50"
  },
  {
   "label": "Baue Szene",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b -P ct/scene.py > build.log 2>&1; grep -q 'SCENE OK' build.log || (tail -15 build.log; false); cp ct/proj.json proj.txt"
  },
  {
   "label": "Render 1403 Frames",
   "progress": "render.log",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/render.py -- mac $PWD/out_ 12 1 9999 > render.log 2>&1; f=$(ls out_*.mp4|head -1); test -n \"$f\" && mv \"$f\" out.mp4 && ls -la out.mp4"
  }

 "steps": [
  {
   "label": "Pack",
   "run": "rm -rf ct tex && cp -R \"$HOME/ShortsRenderAgent/repo/packs/mc4/ct\" \"$HOME/ShortsRenderAgent/repo/packs/mc4/tex\" . && ls ct"
  },
  {
   "label": "Szene bauen",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b -P ct/scene.py > build.log 2>&1; grep -v -i -E 'bearer|api_key|deprecat|use_nodes' build.log | tail -30; grep -q 'SCENE OK' build.log"
  },
  {
   "label": "Standbilder",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/stills.py -- $PWD/o 0.5,2.5,4.5,6.5,9.0,12.0,14.0,15.5,18.0,19.6,21.0,23.0,26.0,30.0 > stills.log 2>&1; tail -40 stills.log | grep -v -i blendkit; ls o/*.jpg >/dev/null 2>&1 || { echo RETRY_CPU; CPU_ONLY=1 CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/stills.py -- $PWD/o 0.5,2.5,4.5,6.5,9.0,12.0,14.0,15.5,18.0,19.6,21.0,23.0,26.0,30.0 > stills_cpu.log 2>&1; tail -30 stills_cpu.log | grep -v -i blendkit; }; cd o && zip -q -j ../mc4_s3.zip *.jpg; cd ..; ls -la mc4_s3.zip; true"
  }
 ],

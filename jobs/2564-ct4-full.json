  {
   "label": "Pack",
   "run": "rm -rf ct tex && cp -R \"$HOME/ShortsRenderAgent/repo/packs/ct4/ct\" \"$HOME/ShortsRenderAgent/repo/packs/ct4/tex\" . && ls ct"
  },
  {
   "label": "Szene bauen",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b -P ct/scene.py > build.log 2>&1; grep -v -i -E 'bearer|api_key' build.log | tail -25; grep -q 'SCENE OK' build.log && cp ct/proj.json ct4_proj.txt"
  },
  {
   "label": "Standbilder v4",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/stills.py -- $PWD/o 0.5,2.0,3.4,7.0,12.0,17.0,21.0,24.0,28.0,32.0 > stills.log 2>&1; tail -3 stills.log; cd o && zip -q -j ../ct4_stills4.zip *.jpg; cd ..; ls -la ct4_stills4.zip; true"
  },
  {
   "label": "Vollrender 1080x1920",
   "run": "CT_ROOT=$PWD /Applications/Blender.app/Contents/MacOS/Blender -b ct/scene.blend -P ct/render.py -- mac $PWD/out_ 20 1 9999 > render.log 2>&1; tail -4 render.log; mv out_*.mp4 ct4_raw.mp4; ls -la ct4_raw.mp4"
  }

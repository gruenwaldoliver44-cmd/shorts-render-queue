{
  "id": "1015-list-sonniss",
  "type": "shell",
  "retries": 1,
  "min_free_gb": 1,
  "steps": [
    "{ echo '== Downloads (sonniss / gdc / audio archives)'; ls -la ~/Downloads | grep -iE 'sonn|gdc|\\.zip|\\.rar|\\.7z|audio|sfx' ; echo; echo '== disk'; df -h ~ | tail -1; echo; for f in ~/Downloads/*[Ss][Oo][Nn][Nn]* ; do [ -e \"$f\" ] || continue; echo \"== $f\"; if [ -d \"$f\" ]; then du -sh \"$f\"; find \"$f\" -maxdepth 2 | head -40; echo files: $(find \"$f\" -type f | wc -l); else ls -la \"$f\"; case \"$f\" in *.zip) unzip -l \"$f\" | tail -1; unzip -l \"$f\" | awk '{print $4}' | cut -d/ -f1-2 | sort -u | head -40;; esac; fi; done; } > dlist.txt 2>&1; cat dlist.txt | head -5"
  ],

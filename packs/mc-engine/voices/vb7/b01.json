[{"index": 8, "params": {"model": "elevenlabs_v4", "prompt": "line", "dialogue": [{"text": "Can I reverse my own fee? I work here.", "voice_type": "preset", "voice_id": "d0374db1-44b9-4f05-939e-0a9ae9dbbe6a"}]}}, {"index": 9, "params": {"model": "elevenlabs_v4", "prompt": "line", "dialogue": [{"text": "Employee perks start after ninety days, honey. Call the number like everybody else.", "voice_type": "preset", "voice_id": "fa64fba4-ad02-405e-99d0-1f085d87c706"}]}}, {"index": 10, "params": {"model": "elevenlabs_v4", "prompt": "line", "dialogue": [{"text": "[warm, wry] So on her break she calls the hotline and waits twenty minutes, listening to the same sad saxophone loop.", "voice_type": "preset", "voice_id": "27c04473-84a9-4b60-a41f-c8e8458bd4f1"}]}}, {"index": 11, "params": {"model": "elevenlabs_v4", "prompt": "line", "dialogue": [{"text": "Fees cannot be reversed at this time. Thank you for banking with us.", "voice_type": "preset", "voice_id": "c3204739-4084-41a3-9dc5-c805b307ec18"}]}}, {"index": 12, "params": {"model": "elevenlabs_v4", "prompt": "line", "dialogue": [{"text": "[warm, wry] Back at her window, a customer needs a pen. There is one, but it's chained to the counter, and Earl, the security guard, just shrugs.", "voice_type": "preset", "voice_id": "27c04473-84a9-4b60-a41f-c8e8458bd4f1"}]}}, {"index": 13, "params": {"model": "elevenlabs_v4", "prompt": "line", "dialogue": [{"text": "People kept walking off with them.", "voice_type": "preset", "voice_id": "d603a8cd-3fe1-55e0-9245-617a2589131e"}]}}, {"index": 14, "params": {"model": "elevenlabs_v4", "prompt": "line", "dialogue": [{"text": "It's a forty-cent pen.", "voice_type": "preset", "voice_id": "d0374db1-44b9-4f05-939e-0a9ae9dbbe6a"}]}}]